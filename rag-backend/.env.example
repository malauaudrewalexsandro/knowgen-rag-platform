# ── Model provider keys (LiteLLM routes to whichever you configure below) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# If you access DeepSeek (or any other model) THROUGH OpenRouter rather than
# the provider directly, use this key instead, and prefix the model string
# with "openrouter/" (see DEFAULT_LLM_MODEL below).
OPENROUTER_API_KEY=
# add more provider keys here as needed — LiteLLM supports 100+ providers

# ── Default models (LiteLLM model strings: "provider/model-name") ──
# Swap these any time without touching code. Examples:
#   openai/gpt-4o-mini | gemini/gemini-2.0-flash | deepseek/deepseek-chat
#   openrouter/deepseek/deepseek-chat   <- DeepSeek accessed VIA OpenRouter
#
# NOTE: DeepSeek's API (direct or via OpenRouter) has no embedding endpoint
# (chat/reasoning models only), so it can power DEFAULT_LLM_MODEL but not
# DEFAULT_EMBEDDING_MODEL. "local/..." runs a free sentence-transformers
# model on your own machine — no key, no cost, no second provider signup.
DEFAULT_LLM_MODEL=openrouter/deepseek/deepseek-chat
DEFAULT_EMBEDDING_MODEL=local/all-MiniLM-L6-v2
DEFAULT_EMBEDDING_DIMS=384
# VLM (image/table analysis) ALSO needs a vision-capable model — DeepSeek's
# standard chat models are text-only, so this must point at a different
# provider if you enable the vlm_enabled toggle. Leave as-is (and just don't
# toggle vlm_enabled) if you don't need image/table analysis yet.
DEFAULT_VLM_MODEL=gemini/gemini-2.0-flash

# ── Storage paths (local disk — TurboVec persists index files here) ──
VECTOR_INDEX_DIR=./storage/vector_indexes
METADATA_DB_PATH=./storage/metadata/metadata.sqlite3
UPLOAD_DIR=./storage/uploads

# ── App ──
APP_ENV=development
LOG_LEVEL=INFO
